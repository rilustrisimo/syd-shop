{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syd-shop",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "sydconstruct.com", "custom_domain": true },
    { "pattern": "www.sydconstruct.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "syd-shop"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_GTM_ID": "GTM-NHSKD7Q8",
    // Meta Pixel / dataset ID (public). The Conversions API token is a
    // secret: wrangler secret put META_CAPI_ACCESS_TOKEN
    "META_PIXEL_ID": "1666399431864427"
  },
}
